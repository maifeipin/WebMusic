# ==============================================================================
# WebMusic Local MusicBrainz Mirror Configuration (.env.example)
# Target: Dedicated Linux Host (PVE / Dedicated VM / NAS / VPS)
# Hard Security Constraint: Listen ONLY on Private LAN / Tailscale IP (Never 0.0.0.0)
# ==============================================================================

# --- 1. Upstream MusicBrainz Docker Version Pinning ---
# Fixed release tag and commit hash from https://github.com/metabrainz/musicbrainz-docker
MB_DOCKER_TAG=v-2026-07-30.1
MB_DOCKER_COMMIT=c8a225fab3ea3a4650d8b1e0fab41d98878adc29
POSTGRES_VERSION=18
MB_SOLR_VERSION=4.1.0

# --- 2. Network & Private Interface Binding ---
# IMPORTANT: Must include trailing colon ':' to bind specifically to that IP
# Example for Tailscale: 100.115.42.126:
# Example for LAN: 192.168.1.100:
# Example for Localhost only: 127.0.0.1:
# DO NOT leave empty, or it will bind to 0.0.0.0 (publicly exposed)!
# Avoid conflict with Synology DSM Web UI (which uses 5000/5001)
MUSICBRAINZ_DOCKER_HOST_IPADDRCOL=127.0.0.1:
MUSICBRAINZ_WEB_SERVER_PORT=5050
MUSICBRAINZ_WEB_SERVER_HOST=localhost

# --- 3. Persistent Storage Paths on Host ---
# Ensure disk partition has >= 100 GB free space for DB and Solr indexes
DATA_ROOT=/opt/musicbrainz-data
PGDATA_DIR=${DATA_ROOT}/pgdata
SOLRDATA_DIR=${DATA_ROOT}/solrdata
DUMP_DIR=${DATA_ROOT}/dumps
BACKUP_DIR=${DATA_ROOT}/backups

# --- 4. Hardware Resources & Memory Limits ---
# Official defaults require at least 8 GB total system RAM
POSTGRES_SHARED_BUFFERS=2048MB
POSTGRES_SHM_SIZE=2GB
SOLR_HEAP=2g
MUSICBRAINZ_SERVER_PROCESSES=4

# --- 5. Data Dump Version Pinning (Fixed Snapshot) ---
# Format: YYYYMMDD-HHMMSS (from https://data.metabrainz.org/pub/musicbrainz/data/fullexport/)
# DO NOT use latest floating URL for reproducible POC
FIXED_DUMP_DATE=20260902-002507
DUMP_BASE_URL=https://data.metabrainz.org/pub/musicbrainz/data/fullexport

# License Minimalization:
# Core data (CC0): mbdump.tar.bz2
# Derived data (CC BY-NC-SA 3.0): mbdump-derived.tar.bz2
DOWNLOAD_CORE_ONLY=true

# --- 6. Docker Compose Configuration ---
COMPOSE_FILE=docker-compose.yml:local/compose/override.yml
