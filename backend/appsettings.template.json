{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnableApiRequestLogging": true,
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "Sqlite": "Data Source=data/webmusic.db",
    "Postgres": "Host=localhost;Database=webmusic;Username=postgres;Password=change_me"
  },
  "Jwt": {
    "Key": "YOUR_STRONG_SECRET_KEY_HERE_MIN_32_CHARS",
    "Issuer": "WebMusic",
    "Audience": "WebMusicUser"
  },
  "Gemini": {
    "ApiKeys": [
      "YOUR_GEMINI_API_KEY_1",
      "YOUR_GEMINI_API_KEY_2"
    ]
  },
  "MusicBrainz": {
    "LocalBaseUrl": "http://192.168.2.18:5050",
    "MirrorVersion": "set-after-local-mirror-refresh"
  },
  "LastFm": {
    "Enabled": false,
    "ApiKey": "SET_ONLY_AFTER_EXPLICIT_APPROVAL"
  },
  "Enrichment": {
    "PriorityScoringEnabled": false
  }
}
