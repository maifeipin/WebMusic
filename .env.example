# WebMusic v2 configuration. Copy this file to .env on MEDIA; never commit .env.

# Required for the PostgreSQL container and backend connection. Use a long random value.
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=webmusic

# Required in production. Generate a unique random value of at least 32 characters.
JWT_KEY=replace-with-a-unique-random-value-of-at-least-32-characters

# Used only when the database has no users. Use a strong password, then remove this line.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password-at-least-12-characters

# Optional external services.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
AI_LYRICS_URL=http://webmusic-ai-lyrics:5001
WHISPER_MODEL=tiny
ENABLE_API_LOGGING=true
